# 依赖与构建产物
node_modules/
dist/
out/
release/
ui/dist/
*.tsbuildinfo

# 运行数据：只保留 data/ 目录骨架，里面的运行时文件一律不入库
data/**
!data/**/
!data/**/.gitkeep

# 内核二进制随包分发，但不入库（体积大）
resources/bin/*
!resources/bin/.gitkeep
resources/geo/*

# 本地环境与日志
.env
.env.local
*.log

# 启动时在 app 启动路径预生成的界面常量配置文件
/config.json

# VS Code 计数器插件产物
.VSCodeCounter/
