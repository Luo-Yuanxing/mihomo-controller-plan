{
  "name": "mihomo-controller-plan",
  "productName": "代理控制面板",
  "version": "0.1.0",
  "private": true,
  "description": "mihomo 代理控制面板：规则热更新 + 内核托管 + 系统代理守护",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:server": "node electron/dev-server.mjs",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev:electron": "node electron/dev-launcher.mjs",
    "build": "tsc -p tsconfig.json && vite build --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.21.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
